# Build outputs (Xcode derived data, produced by the scripts under dm/ios)
.iosdd/
.iosdd_mac/
.iosdd_*/
.DS_Store
__pycache__/
# Made from each shader build's Mac outputs (c1_guard.py, cb_extent.py; the NSP script makes them), not committed
dm/games/*/c1_full.tsv
dm/games/*/cb_extent.tsv
# coverage.py data and its JSON report (pyproject.toml, [tool.coverage.run])
.coverage
.coverage.*
/coverage.json
# The Python virtualenv scripts/release/nx18-setup.sh makes for the build's modules
.venv/
# The owner's own inputs kept in the checkout, such as a UI font for --ui-font (local/fonts/): never committed. A font of one's own is bundled into the app built
# on that Mac only (build_ipa_from_nsp.py refuses one inside the checkout that git does not ignore; dm/tools/tests/test_private_fonts.py fails on a tracked one)
/local/
*.private.ttf
*.private.otf
*.private.ttc
