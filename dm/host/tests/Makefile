	$(B)/t_nv
	$(B)/t_vi_history $(QUIET)
	$(B)/t_nfc
	$(B)/t_sw2_mode
	$(B)/t_motion
	$(B)/t_motion_apple
	$(B)/t_pad_apple
	$(B)/t_account
	$(B)/t_home_quit
	$(B)/t_home_quit_mac
	$(B)/t_ctrl_prompt
	$(B)/t_motion_pro
	$(B)/t_motion_pro_mac
	$(B)/t_jc1
	TMPDIR="$(abspath $(B))" $(B)/t_hid
	$(B)/t_pad_hid
	$(B)/t_pad_hid_mac
	$(B)/t_pad_pro
	$(B)/t_switch2
	$(B)/t_haptics
	$(B)/t_haptics_apple
	$(B)/t_drawable_count
